{
    "class_name": "ObjectDetectionDefinition",
    "description": "Synchronous Ultralytics-compatible YOLO detection on an explicitly selected CPU or NVIDIA CUDA device. Models and artifacts are selected by stable managed-library IDs.",
    "category": "det",
    "folder": "Detection",
    "input_nodes": [
        {
            "name": "frame",
            "has_default": false
        }
    ],
    "output_nodes": [
        "detections"
    ],
    "parameters": {
        "model_id": {
            "type": "str",
            "description": "Managed model; leave empty to idle until a compatible model is uploaded",
            "default": "",
            "required": false,
            "restart_for_change": true,
            "ui_hint": "model_library",
            "device_param": "device_id"
        },
        "device_id": {
            "type": "str",
            "description": "Inference device",
            "default": "cpu",
            "required": true,
            "restart_for_change": true,
            "ui_hint": "device_registry",
            "model_param": "model_id",
            "allowed_device_kinds": [
                "cpu",
                "cuda"
            ]
        },
        "confidence_threshold": {
            "type": "float",
            "description": "Minimum detection confidence",
            "default": 0.25,
            "required": false,
            "min": 0.0,
            "max": 1.0,
            "restart_for_change": false
        },
        "iou_threshold": {
            "type": "float",
            "description": "Non-maximum-suppression IoU threshold",
            "default": 0.45,
            "required": false,
            "min": 0.0,
            "max": 1.0,
            "restart_for_change": false
        },
        "max_detections": {
            "type": "int",
            "description": "Maximum detections returned per frame",
            "default": 100,
            "required": false,
            "min": 1,
            "max": 1000,
            "restart_for_change": false
        },
        "image_size": {
            "type": "int",
            "description": "Optional square inference size override (0 uses model metadata)",
            "default": 0,
            "required": false,
            "min": 0,
            "max": 4096,
            "restart_for_change": true
        }
    }
}
