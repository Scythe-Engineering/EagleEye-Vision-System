{
    "class_name": "PnpCameraLocalization2DDefinition",
    "description": "Rust-backed level-robot field XY localization using capture-aligned native NT gyro yaw radians CCW about NWU +Z and current camera mounting.",
    "category": "proc",
    "folder": "Localization",
    "input_nodes": [
        {
            "name": "detections",
            "has_default": false
        },
        {
            "name": "gyro_samples",
            "has_default": true
        }
    ],
    "output_nodes": [
        "camera_pose",
        "pose_meta",
        "diagnostics"
    ],
    "parameters": {
        "camera_bus_id": {
            "type": "str",
            "description": "Camera USB bus ID used to resolve calibration files (for example: '0' or '0-1').",
            "required": true,
            "restart_for_change": true
        },
        "apriltag_map_path": {
            "type": "str",
            "description": "Path to the apriltag map file",
            "default": "{project_root}/config/apriltag_map.fmap",
            "required": true,
            "restart_for_change": true
        },
        "refinement_iterations": {
            "type": "int",
            "description": "Bounded pixel-reprojection XY refinement iterations after constrained linear initialization",
            "default": 10,
            "required": false,
            "min": 0,
            "max": 100,
            "restart_for_change": false
        },
        "gyro_max_gap_ms": {
            "type": "float",
            "description": "Maximum bracketing gyro gap",
            "default": 100,
            "min": 0,
            "max": 10000,
            "required": false,
            "restart_for_change": false
        },
        "gyro_nearest_ms": {
            "type": "float",
            "description": "Maximum nearest gyro offset when no samples bracket capture (no extrapolation); oversized brackets are rejected",
            "default": 20,
            "min": 0,
            "max": 10000,
            "required": false,
            "restart_for_change": false
        }
    }
}
