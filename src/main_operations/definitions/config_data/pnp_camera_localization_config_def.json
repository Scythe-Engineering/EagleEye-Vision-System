{
    "class_name": "PnpCameraLocalizationDefinition",
    "description": "Calculates camera pose (position and orientation) relative to known AprilTag markers using a Perspective-n-Point algorithm",
    "category": "proc",
    "folder": "Localization",
    "input_nodes": [
        {
            "name": "detections",
            "has_default": false
        },
        {
            "name": "robot_yaw",
            "has_default": false
        }
    ],
    "output_nodes": [
        "camera_pose",
        "pose_meta"
    ],
    "parameters": {
        "camera_bus_id": {
            "type": "str",
            "description": "Camera USB bus ID used to resolve calibration files (for example: '0' or '0-1').",
            "required": true,
            "restart_for_change": true
        },
        "apriltag_map_path": {
            "type": "str",
            "description": "Path to the apriltag map file",
            "default": "{project_root}/config/apriltag_map.fmap",
            "required": true,
            "restart_for_change": true
        }
    }
}
