{
    "class_name": "FpsLimiter",
    "description": "Limits frame rate by sleeping to maintain target FPS",
    "category": "proc",
    "parameters": {
        "fps": {
            "type": "float",
            "description": "Target frames per second to maintain",
            "default": 30.0,
            "required": true,
            "min": 0.1,
            "max": 120.0,
            "restart_for_change": false
        }
    }
}
