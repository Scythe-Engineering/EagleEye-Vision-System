{
    "class_name": "CameraAdjust",
    "description": "Hardware-accelerated camera adjustments for brightness, contrast, saturation, gain, and exposure.",
    "category": "prep",
    "folder": "Preprocessing",
    "input_nodes": [
        {
            "name": "frame",
            "has_default": false
        },
        {
            "name": "detections",
            "has_default": true
        }
    ],
    "output_nodes": [
        "frame"
    ],
    "parameters": {
        "camera_bus_id": {
            "type": "str",
            "description": "Deterministic camera bus ID for hardware controls (same ID as device_input and camera calibration).",
            "required": true,
            "restart_for_change": true
        },
        "brightness": {
            "type": "float",
            "description": "Brightness offset normalized in range [-1, 1].",
            "default": 0.0,
            "required": false,
            "min": -1,
            "max": 1,
            "step": 0.001,
            "ui_control": "slider",
            "restart_for_change": false
        },
        "contrast": {
            "type": "float",
            "description": "Contrast multiplier normalized in range [0, 1].",
            "default": 0.5,
            "required": false,
            "min": 0,
            "max": 1,
            "step": 0.001,
            "ui_control": "slider",
            "restart_for_change": false
        },
        "saturation": {
            "type": "float",
            "description": "Saturation multiplier normalized in range [-1, 1].",
            "default": 0.406,
            "required": false,
            "min": -1,
            "max": 1,
            "step": 0.001,
            "ui_control": "slider",
            "restart_for_change": false
        },
        "gain": {
            "type": "float",
            "description": "Gain control normalized in range [0, 1].",
            "default": 0.0,
            "required": false,
            "min": 0,
            "max": 1,
            "step": 0.001,
            "ui_control": "slider",
            "restart_for_change": false
        },
        "exposure": {
            "type": "float",
            "description": "Exposure time normalized in range [0, 1].",
            "default": 0.5,
            "required": false,
            "min": 0,
            "max": 1,
            "step": 0.001,
            "ui_control": "slider",
            "restart_for_change": false
        }
    }
}
