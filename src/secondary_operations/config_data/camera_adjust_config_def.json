{
    "class_name": "CameraAdjust",
    "description": "Hardware-accelerated camera adjustments for brightness, contrast, exposure, saturation, and hue.",
    "category": "prep",
    "parameters": {
        "brightness": {
            "type": "float",
            "description": "Brightness offset (-100..100).",
            "default": 0.0,
            "required": false,
            "min": -100,
            "max": 100,
            "restart_for_change": false
        },
        "contrast": {
            "type": "float",
            "description": "Contrast multiplier (0.5..3.0).",
            "default": 1.0,
            "required": false,
            "min": 0.5,
            "max": 3.0,
            "restart_for_change": false
        },
        "exposure": {
            "type": "float",
            "description": "Exposure control mapped to gamma (-2..2).",
            "default": 0.0,
            "required": false,
            "min": -2.0,
            "max": 2.0,
            "restart_for_change": false
        },
        "saturation": {
            "type": "float",
            "description": "Saturation multiplier (0.0..2.0).",
            "default": 1.0,
            "required": false,
            "min": 0.0,
            "max": 2.0,
            "restart_for_change": false
        },
        "hue": {
            "type": "int",
            "description": "Hue shift in degrees (-180..180).",
            "default": 0,
            "required": false,
            "min": -180,
            "max": 180,
            "restart_for_change": false
        }
    }
}
