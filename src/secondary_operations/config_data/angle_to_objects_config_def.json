{
    "class_name": "AngleToObjects",
    "description": "Calculate horizontal angles to detected objects from color threshold detections, sorted by area descending",
    "category": "proc",
    "folder": "Output",
    "input_nodes": [
        {
            "name": "detections",
            "has_default": false
        }
    ],
    "output_nodes": [
        "angles"
    ],
    "parameters": {
        "camera_fov_degrees": {
            "type": "float",
            "description": "Horizontal field of view in degrees for angle calculations",
            "default": 60.0,
            "required": false,
            "min": 10.0,
            "max": 180.0,
            "restart_for_change": false
        }
    }
}
