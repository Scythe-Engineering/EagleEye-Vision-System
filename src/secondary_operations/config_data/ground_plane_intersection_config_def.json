{
    "class_name": "GroundPlaneIntersection",
    "description": "Ground plane intersection for 3D position estimation",
    "category": "proc",
    "folder": "Output",
    "input_nodes": [
        {
            "name": "detections",
            "has_default": false
        },
        {
            "name": "camera_pose",
            "has_default": false
        }
    ],
    "output_nodes": [
        "positions_3d"
    ],
    "parameters": {
        "camera_bus_id": {
            "type": "str",
            "description": "Camera USB bus ID used to resolve intrinsics.",
            "required": true,
            "restart_for_change": false
        },
        "ground_level": {
            "type": "float",
            "description": "Ground-plane height in field coordinates, in meters.",
            "default": 0.0,
            "required": false,
            "restart_for_change": false
        }
    }
}
